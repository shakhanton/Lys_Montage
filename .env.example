# Локальний запуск синку Instagram. Скопіюй у .env і встав свій токен.
#   cp .env.example .env
# Файл .env у .gitignore — в репозиторій не потрапить.
#
# Як отримати токен — docs/instagram-sync.md, розділ 1.
IG_ACCESS_TOKEN=

# Скільки публікацій запросити в API і скільки показати на сайті.
IG_LIMIT=12
IG_MAX_POSTS=9
